{
  "name": "studyflow",
  "description": "Native lesson-to-quiz study companion with a personal timetable",
  "license": "MIT",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.29",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "bundle": "expo export --platform ios --platform android",
    "format": "prettier --write App.tsx index.ts src tests *.json .github/workflows/*.yml README.md",
    "format:check": "prettier --check App.tsx index.ts src tests *.json .github/workflows/*.yml README.md"
  },
  "private": true
}
